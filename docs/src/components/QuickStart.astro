---
function formatCode(code: string, prompt = "$"): string {
  return code
    .split("\n")
    .map((line) =>
      line
        ? `<span class="text-accent-cyan">${prompt}</span> <span class="text-text-primary">${line}</span>`
        : ""
    )
    .join("\n");
}

const steps = [
  {
    number: "1",
    title: "Install the CLI",
    code: `uv tool install codelattice`,
    note: "Or pipx install codelattice. uv fetches Python 3.12 for you if needed.",
  },
  {
    number: "2",
    title: "Register with Claude Code",
    code: `codelattice install`,
    note: "Adds the /codelattice skill and the MCP server for every project. Use --project to write them into the current repo instead.",
  },
  {
    number: "3",
    title: "Index your project",
    code: `/codelattice .`,
    prompt: "&gt;",
    note: "Type this inside Claude Code (restart it once after step 2). Then ask questions as usual; Claude uses search_code and find_symbol instead of grep.",
  },
];
---

<section id="quickstart" class="py-20 bg-bg-primary">
  <div class="max-w-4xl mx-auto px-6">
    <div class="text-center mb-14">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Get Started in 60 Seconds</h2>
      <p class="text-text-secondary text-lg max-w-2xl mx-auto">
        Zero config. No API keys. Same three steps as graphify.
      </p>
    </div>

    <div class="space-y-8">
      {steps.map((step) => (
        <div class="flex gap-5">
          <!-- Step number -->
          <div class="flex-shrink-0 w-10 h-10 rounded-full bg-accent-blue/10 border border-accent-blue/20 flex items-center justify-center">
            <span class="text-accent-blue font-bold text-lg">{step.number}</span>
          </div>

          <div class="flex-1 min-w-0">
            <h3 class="text-lg font-semibold mb-3">{step.title}</h3>

            <!-- Code block -->
            <div class="rounded-lg border border-border overflow-hidden">
              <div class="flex items-center gap-2 px-4 py-2 bg-bg-secondary border-b border-border">
                <div class="flex gap-1.5">
                  <div class="w-2 h-2 rounded-full bg-red-500/60"></div>
                  <div class="w-2 h-2 rounded-full bg-yellow-500/60"></div>
                  <div class="w-2 h-2 rounded-full bg-green-500/60"></div>
                </div>
              </div>
              <pre class="p-4 bg-bg-secondary/50 text-sm leading-relaxed overflow-x-auto"><code set:html={formatCode(step.code, step.prompt)} /></pre>
            </div>

            {step.note && (
              <p class="text-text-secondary text-sm mt-3">{step.note}</p>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Supported languages -->
    <div class="mt-14 text-center">
      <p class="text-text-muted text-sm mb-3">Supported languages</p>
      <div class="flex justify-center gap-3">
        {["Python", "TypeScript", "JavaScript"].map((lang) => (
          <span class="px-3 py-1.5 rounded-lg text-sm font-medium bg-bg-card border border-border text-text-secondary">
            {lang}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
